<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed for the JDBC connection to PostgreSQL on the dev machine. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".BankingApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bank99">

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.register.RegisterActivity" />
        <activity android:name=".ui.dashboard.DashboardActivity" />
        <activity android:name=".ui.deposit.DepositActivity" />
        <activity android:name=".ui.withdraw.WithdrawActivity" />
        <activity android:name=".ui.transfer.TransferActivity" />
        <activity android:name=".ui.transfer.OtpActivity" />
        <activity android:name=".ui.transaction.TransactionHistoryActivity" />
        <activity android:name=".ui.profile.ProfileActivity" />
        <activity android:name=".ui.profile.ChangePasswordActivity" />

    </application>

</manifest>
