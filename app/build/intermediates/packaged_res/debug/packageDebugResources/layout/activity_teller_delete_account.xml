<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/teller_delete_account_title" android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="16dp" />
    <EditText android:id="@+id/etAccountNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/hint_account_number" android:inputType="number" />
    <Button android:id="@+id/btnDelete" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/btn_delete" />
    <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
</LinearLayout>
