<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_title" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />

    <Button android:id="@+id/btnChangePassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/btn_change_password" />
</LinearLayout>
