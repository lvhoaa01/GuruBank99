<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/white"
    android:layout_marginBottom="6dp">
    <TextView android:id="@+id/tvAcctNum"  android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" />
    <TextView android:id="@+id/tvAcctType" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/textSecondary" />
    <TextView android:id="@+id/tvBalance"  android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/primaryDark" />
</LinearLayout>
